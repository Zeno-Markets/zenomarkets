{
  "name": "@zeno/keeper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Zeno keeper: keeps the testnet mock price feeds fresh and fills limit orders whose trigger price is reached.",
  "scripts": {
    "build": "echo \"services/keeper runs from source (tsx)\" && exit 0",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "echo \"scaffold: services/keeper lint\" && exit 0",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "copy:e2e": "tsx scripts/copy-e2e.ts"
  },
  "dependencies": {
    "@zeno/config": "workspace:*",
    "@zeno/sdk": "workspace:*",
    "viem": "^2.21.0",
    "@zeno/types": "workspace:*",
    "postgres": "^3.4.0"
  }
}
